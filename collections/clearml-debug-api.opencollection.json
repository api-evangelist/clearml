{
  "opencollection": "1.0.0",
  "info": {
    "name": "ClearML REST Auth Debug API",
    "version": "2.30"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Debug",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health check",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.clear.ml/debug.ping"
          },
          "docs": "Health check"
        }
      ]
    }
  ],
  "bundled": true
}